{
  "type": "webhook",
  "name": "save_lead",
  "description": "Saves the caller's confirmed quote request so the shop can follow up. Call it once, only after the caller has confirmed the summary you read back.",
  "api_schema": {
    "url": "https://fil-rouge-atelier.vercel.app/api/voice-lead",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "The confirmed quote request.",
      "required": true,
      "properties": [
        {
          "id": "name",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Caller's full name.",
          "required": true,
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null
        },
        {
          "id": "phone",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Caller's phone number, digits as confirmed.",
          "required": true,
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null
        },
        {
          "id": "email",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Caller's email, or an empty string if they skipped it.",
          "required": false,
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null
        },
        {
          "id": "car",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Year, make and model, for example 2024 Porsche 911.",
          "required": true,
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null
        },
        {
          "id": "service",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "One or more of: Full-body PPF, Full front PPF, Color change wrap, Ceramic coating, Window tint, Chrome delete, Wheels or body kit. Separate several with commas.",
          "required": true,
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null
        },
        {
          "id": "budget",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "The budget the caller chose.",
          "required": true,
          "enum": [
            "Under $1,000",
            "$1,000-$3,000",
            "$3,000-$6,000",
            "$6,000+"
          ],
          "dynamic_variable": "",
          "constant_value": ""
        },
        {
          "id": "preferred_time",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Preferred appointment time.",
          "required": true,
          "enum": [
            "Flexible",
            "Weekday morning",
            "Weekday afternoon"
          ],
          "dynamic_variable": "",
          "constant_value": ""
        },
        {
          "id": "sms_consent",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "yes only if the caller clearly agreed to texts, otherwise no.",
          "required": true,
          "enum": [
            "yes",
            "no"
          ],
          "dynamic_variable": "",
          "constant_value": ""
        },
        {
          "id": "summary",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "One neutral sentence about the request, under 300 characters, no links.",
          "required": true,
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null
        }
      ],
      "value_type": "llm_prompt"
    },
    "request_headers": [
      {
        "type": "secret",
        "name": "x-voice-secret",
        "secret_id": ""
      }
    ],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "response_filter": null
  },
  "response_timeout_secs": 20,
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "assignments": [],
  "interruption_mode": "allow",
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "execution_mode": "immediate",
  "tool_error_handling_mode": "auto",
  "response_mocks": []
}